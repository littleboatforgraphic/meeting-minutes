MM_COMPANY_CONFIG=/config/company.yaml
MM_DATA_DIR=/data
# Must be a random value: the app refuses to start on HTTPS with this placeholder (new-company.sh generates one).
MM_SECRET_KEY=change-me
MM_PUBLIC_BASE_URL=https://acme.minutes.example.com
# DATABASE_URL=postgresql+psycopg://...   (default: SQLite in MM_DATA_DIR)

# llm-gateway key for this company: <client>/meeting-minutes/prod
LLM_BASE_URL=https://llm.example.com/v1
LLM_API_KEY=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURITY=starttls

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Placeholder: token the future central portal uses to read /api/central/info
CENTRAL_UI_TOKEN=
